<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24.0" alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom right, #1A1A2E, #16213E); -fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.snek.controller.MenuController">
    <Label text="SNEK" style="-fx-font-size: 68px; -fx-font-weight: 900; -fx-text-fill: #00FFCC; -fx-effect: dropshadow(gaussian, rgba(0,255,204,0.6), 25, 0.5, 0, 0);" />

    <VBox spacing="16" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <Button text="START GAME" onAction="#handlePlay" prefWidth="240"
                style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-text-fill: #FFFFFF; -fx-background-radius: 35px; -fx-padding: 16px; -fx-font-weight: 900; -fx-font-size: 18px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(56,239,125,0.5), 15, 0.3, 0, 5);" />

        <Button text="LEADERBOARDS" onAction="#handleHighscores" prefWidth="240"
                style="-fx-background-color: linear-gradient(to right, #8E2DE2, #4A00E0); -fx-text-fill: #FFFFFF; -fx-background-radius: 35px; -fx-padding: 16px; -fx-font-weight: 900; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(142,45,226,0.5), 15, 0.3, 0, 5);" />

        <Button text="DISCONNECT" onAction="#handleLogout" prefWidth="240"
                style="-fx-background-color: transparent; -fx-border-color: #E94560; -fx-border-radius: 35px; -fx-border-width: 2px; -fx-text-fill: #E94560; -fx-background-radius: 35px; -fx-padding: 14px; -fx-font-weight: 900; -fx-font-size: 14px; -fx-cursor: hand;" />
    </VBox>
</VBox>