<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" alignment="CENTER" style="-fx-background-color: #FAF5ED; -fx-base: #FAF5ED; -fx-control-inner-background: #FFFFFF; -fx-table-cell-border-color: #FAF5ED; -fx-selection-bar: #C5E0B4; -fx-selection-bar-text: #2D4A22; -fx-font-family: 'Comic Sans MS', 'Nunito', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.snek.controller.HighscoreController">
    <padding>
        <Insets top="30" right="60" bottom="30" left="60" />
    </padding>

    <Label text="hall of fame 🐍" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #6E3B3D;" />

    <TableView fx:id="scoreTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 20px; -fx-border-radius: 20px; -fx-border-color: #C5E0B4; -fx-border-width: 4px; -fx-padding: 5px;">
        <columns>
            <TableColumn fx:id="playerColumn" text="player" prefWidth="330" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #4E6546;" />
            <TableColumn fx:id="scoreColumn" text="score" prefWidth="330" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-alignment: CENTER-RIGHT; -fx-text-fill: #4E6546;" />
        </columns>
    </TableView>

    <Button text="go back" onAction="#handleBack" prefWidth="220"
            style="-fx-background-color: #E2E2E2; -fx-text-fill: #404040; -fx-background-radius: 50px; -fx-padding: 12px; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
</VBox>