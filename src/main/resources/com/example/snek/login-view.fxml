<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" alignment="CENTER" style="-fx-background-color: #FAF5ED; -fx-font-family: 'Comic Sans MS', 'Nunito', sans-serif;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.snek.controller.AuthController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="snek terminal 🍵" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4E6546;" />
    <Label text="authenticate to play!" style="-fx-text-fill: #7D9B76; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;" />

    <TextField fx:id="usernameField" promptText="username" maxWidth="260"
               style="-fx-background-color: #FFFFFF; -fx-text-fill: #2D4A22; -fx-prompt-text-fill: #A3B89F; -fx-background-radius: 50px; -fx-padding: 12px 20px; -fx-border-color: #C5E0B4; -fx-border-radius: 50px; -fx-border-width: 3px; -fx-font-size: 14px; -fx-font-weight: bold;" />

    <PasswordField fx:id="passwordField" promptText="password" maxWidth="260"
                   style="-fx-background-color: #FFFFFF; -fx-text-fill: #2D4A22; -fx-prompt-text-fill: #A3B89F; -fx-background-radius: 50px; -fx-padding: 12px 20px; -fx-border-color: #C5E0B4; -fx-border-radius: 50px; -fx-border-width: 3px; -fx-font-size: 14px; -fx-font-weight: bold;" />

    <VBox spacing="12" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
        <Button text="login" onAction="#handleLogin" maxWidth="260"
                style="-fx-background-color: #C5E0B4; -fx-text-fill: #2D4A22; -fx-background-radius: 50px; -fx-padding: 12px; -fx-font-weight: bold; -fx-font-size: 16px; -fx-cursor: hand;" />

        <Button text="register new player" onAction="#handleRegister" maxWidth="260"
                style="-fx-background-color: transparent; -fx-border-color: #FFB6B9; -fx-border-radius: 50px; -fx-border-width: 3px; -fx-text-fill: #6E3B3D; -fx-background-radius: 50px; -fx-padding: 10px; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
    </VBox>
</VBox>